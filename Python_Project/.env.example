# ---------------------------------------------------------------------------
# Copy this file to ".env" and put your own values in it.
# The .env file is listed in .gitignore, so it never reaches GitHub.
#
# These settings replace the connection string that used to live in Web.config:
#   Data Source=LAPTOP-151ISPLI\MSSQLSERVER01;
#   Initial Catalog=Educational_Post_Analysis;
#   Integrated Security=True
# ---------------------------------------------------------------------------

# Your SQL Server instance. Examples:
#   localhost
#   localhost\SQLEXPRESS
#   LAPTOP-151ISPLI\MSSQLSERVER01
DB_SERVER=localhost\SQLEXPRESS

# The database created by database/schema.sql
DB_NAME=Educational_Post_Analysis

# The ODBC driver installed on your machine.
# Check Windows -> "ODBC Data Sources (64-bit)" -> Drivers tab for the name.
DB_DRIVER=ODBC Driver 17 for SQL Server

# yes = Windows Authentication (what the original project used)
# no  = SQL Server Authentication, using DB_USER and DB_PASSWORD below
DB_TRUSTED_CONNECTION=yes

# Only needed when DB_TRUSTED_CONNECTION=no
DB_USER=your_sql_username
DB_PASSWORD=your_sql_password

# Any random text. Flask uses it to sign the login session cookie.
SECRET_KEY=change-this-to-any-random-text
